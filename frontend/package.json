{
  "name": "tracesync-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.15.0 <25", "npm": ">=11 <13" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/support/run-live-browser.mjs --controlled",
    "test:browser:live": "node tests/support/run-live-browser.mjs",
    "test:isolation": "node --test tests/support/isolation.test.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
