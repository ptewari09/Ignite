# Public browser configuration only. Never put credentials in VITE_* variables.
# Projects and uploads use the local backend; Overview renders without it.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Match the backend's TRACESYNC_MAX_UPLOAD_BYTES when changing its 20 MiB default.
VITE_MAX_UPLOAD_BYTES=20971520
