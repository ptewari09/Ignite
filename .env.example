# Copy to .env at the repository root. Real .env files are ignored by Git.
TRACESYNC_ENVIRONMENT=local
TRACESYNC_LOG_LEVEL=INFO
# Relative SQLite paths always resolve from the repository root.
TRACESYNC_DATABASE_URL=sqlite+pysqlite:///data/local/tracesync.db
# Pydantic Settings reads list values as JSON.
TRACESYNC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# File-part size, expanded XLSX size, and physical row limit per parsed sheet.
TRACESYNC_MAX_UPLOAD_BYTES=20971520
TRACESYNC_MAX_WORKBOOK_UNCOMPRESSED_BYTES=104857600
TRACESYNC_MAX_SHEET_ROWS=50000
